{
  "name": "zabaca-web",
  "type": "module",
  "version": "1.0.0",
  "description": "Zabaca company website monorepo built with Astro",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "bun run --cwd apps/web dev",
    "build": "bun run --cwd apps/web build",
    "preview": "bun run --cwd apps/web preview",
    "typecheck": "bun run --cwd apps/web typecheck",
    "lint": "bun run --cwd apps/web lint",
    "format": "bun run --cwd apps/web format",
    "format:check": "bun run --cwd apps/web format:check",
    "clean": "bun run --cwd apps/web clean && rm -rf node_modules"
  },
  "keywords": ["astro", "react", "typescript", "tailwindcss", "monorepo", "bun-workspace"],
  "author": "Zabaca",
  "license": "MIT",
  "engines": {
    "bun": ">=1.2.0"
  },
  "packageManager": "bun@1.3.5",
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
